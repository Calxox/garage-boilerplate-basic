# ══════════════════════════════════════════════════════════════════
# Garage Boilerplate — the ONE env file
#
#   1. Copy to .env:        cp .env.example .env
#   2. Fill in the values below
#   3. Sync to packages:    pnpm run env:sync
#      (also runs automatically before `pnpm run dev`)
#
# frontend/.env.local and backend/.env are GENERATED from this file —
# never edit them by hand. Reference: docs/ENV-VARS.md
#
# There is no local emulator — the app always talks to the real Firebase
# project below. Create a free (Spark plan) Firebase project with Auth and
# Firestore enabled: https://console.firebase.google.com
# ══════════════════════════════════════════════════════════════════

# ── Firebase project ────────────────────────────────────────────────
# Your Firebase project id — must match .firebaserc → projects.default
# Named with the NEXT_PUBLIC_ prefix (like the rest of the web app config
# below) because this exact name is what frontend/.env.local, backend/.env,
# and Vercel's environment variables all use too — same name everywhere,
# nothing gets silently renamed in between.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Service account JSON, base64-encoded. SERVER-ONLY SECRET — never commit.
# Firebase Console → Project settings → Service accounts → Generate new private key
#   macOS (BSD base64):  base64 -i service-account.json | tr -d '\n'
#   Linux (GNU base64):  base64 -w 0 service-account.json
#   PowerShell:          [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\path\service-account.json'))
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# ── Firebase web app config ─────────────────────────────────────────
# Firebase Console → Project settings → Your apps → (your web app) → firebaseConfig
# These are safe for the browser — that's what the NEXT_PUBLIC_ prefix means.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled on the web app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=

# ── Backend API ─────────────────────────────────────────────────────
# Allowed CORS origin for /api (empty = all cross-origin requests denied)
CORS_ORIGIN=
# Local port for the Functions API
PORT=5001

# ── IBM Cloud Object Storage ────────────────────────────────────────
# Backend-only — stores hazard imagery and detection data. See
# docs/ENV-VARS.md for how to generate these from an existing instance.
# IBM Cloud console → your Object Storage instance → Endpoints (for
# COS_ENDPOINT) and Service credentials (for the rest).
COS_ENDPOINT=
COS_API_KEY_ID=
COS_INSTANCE_CRN=
COS_BUCKET_NAME=

# ── IBM Cloudant (Database) ─────────────────────────────────────────
# Backend-only — replaces Firestore. IBM Cloud console → your Cloudant
# instance → Service credentials → Create credential (Manager role,
# Secrets Manager control OFF, Authentication method IAM). See
# docs/ENV-VARS.md for details.
CLOUDANT_URL=
CLOUDANT_APIKEY=
CLOUDANT_USERNAME=

# ── IBM watsonx.ai ──────────────────────────────────────────────────
# Backend-only — foundation model text generation. IBM Cloud console →
# your watsonx.ai project → Manage → General (for WATSONX_AI_PROJECT_ID),
# and an IAM API key with access to Watson Machine Learning. See
# docs/ENV-VARS.md for details.
WATSONX_AI_URL=
WATSONX_AI_APIKEY=
WATSONX_AI_PROJECT_ID=
# Optional — defaults to ibm/granite-13b-instruct-v2 if unset
WATSONX_AI_MODEL_ID=

# ── IBM App ID (Auth) ────────────────────────────────────────────────
# Replaces Firebase Auth. IBM Cloud console → your App ID instance →
# Service credentials → Create credential (Manager role, Secrets
# Manager control OFF). See docs/ENV-VARS.md for details.
# Backend-only — full management access, never expose to the browser.
APPID_API_KEY=
APPID_SECRET=
APPID_MANAGEMENT_URL=
APPID_SERVICE_ENDPOINT=
# Safe for the browser — used to build the App ID login client.
NEXT_PUBLIC_APPID_TENANT_ID=
NEXT_PUBLIC_APPID_CLIENT_ID=
NEXT_PUBLIC_APPID_OAUTH_SERVER_URL=
NEXT_PUBLIC_APPID_DISCOVERY_ENDPOINT=
NEXT_PUBLIC_APPID_PROFILES_URL=

# ── Claude Code MCP (optional) ──────────────────────────────────────
# Google Stitch design-to-code — https://stitch.withgoogle.com/settings
STITCH_API_KEY=
